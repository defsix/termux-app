<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <Preference
        app:key="termux"
        app:title="@string/termux_preferences_title"
        app:summary="@string/termux_preferences_summary"
        app:fragment="com.termux.app.fragments.settings.TermuxPreferencesFragment"/>

    <PreferenceCategory app:title="File receivers">

        <SwitchPreferenceCompat
            app:key="file_view_receiver_enabled"
            app:title="Show Termux in &quot;Open with&quot; menus"
            app:summary="Show Termux as an option when opening supported files from other apps."
            app:persistent="false"
            app:defaultValue="true"/>

        <SwitchPreferenceCompat
            app:key="file_share_receiver_enabled"
            app:title="Show Termux in &quot;Share&quot; menus"
            app:summary="Show Termux as an option when sharing supported files from other apps."
            app:persistent="false"
            app:defaultValue="true"/>

    </PreferenceCategory>

    <PreferenceCategory app:title="Developer options">

        <EditTextPreference
            app:key="file_view_receiver_mime_types"
            app:title="&quot;Open with&quot; file type whitelist"
            app:summary="Comma-separated MIME categories (application, audio, image, text, video) Termux should appear for in &quot;Open with&quot; menus. Leave blank to allow all types."
            app:persistent="false"
            app:dialogTitle="&quot;Open with&quot; file type whitelist"/>

        <EditTextPreference
            app:key="file_share_receiver_mime_types"
            app:title="&quot;Share&quot; file type whitelist"
            app:summary="Comma-separated MIME categories (application, audio, image, message, multipart, text, video) Termux should appear for in &quot;Share&quot; menus. Leave blank to allow all types."
            app:persistent="false"
            app:dialogTitle="&quot;Share&quot; file type whitelist"/>

    </PreferenceCategory>

    <Preference
        app:key="termux_api"
        app:title="@string/termux_api_preferences_title"
        app:summary="@string/termux_api_preferences_summary"
        app:isPreferenceVisible="false"
        app:fragment="com.termux.app.fragments.settings.TermuxAPIPreferencesFragment"/>

    <Preference
        app:key="termux_float"
        app:title="@string/termux_float_preferences_title"
        app:summary="@string/termux_float_preferences_summary"
        app:isPreferenceVisible="false"
        app:fragment="com.termux.app.fragments.settings.TermuxFloatPreferencesFragment"/>

    <Preference
        app:key="termux_tasker"
        app:title="@string/termux_tasker_preferences_title"
        app:summary="@string/termux_tasker_preferences_summary"
        app:isPreferenceVisible="false"
        app:fragment="com.termux.app.fragments.settings.TermuxTaskerPreferencesFragment"/>

    <Preference
        app:key="termux_widget"
        app:title="@string/termux_widget_preferences_title"
        app:summary="@string/termux_widget_preferences_summary"
        app:isPreferenceVisible="false"
        app:fragment="com.termux.app.fragments.settings.TermuxWidgetPreferencesFragment"/>

    <Preference
        app:key="about"
        app:title="@string/about_preference_title"
        app:persistent="false"/>
    <!-- app:layout="@layout/preference_markdown_text" -->

    <Preference
        app:key="donate"
        app:title="@string/donate_preference_title"
        app:persistent="false"
        app:isPreferenceVisible="false"/>

</PreferenceScreen>
